rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: Only authenticated users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Fact checks: Public read, written only by Cloud Functions/Admin
    match /fact_checks/{docId} {
      allow read: if true;
      allow write: if false; 
    }

    // Manifestos: Public read, written only by Cloud Functions/Admin
    match /manifestos/{docId} {
      allow read: if true;
      allow write: if false; 
    }
    
    // Quiz Results: Authenticated users can create and read only their own results
    match /quiz_results/{resultId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Analytics (if using Firestore for custom events): Write-only
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
